# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text file types
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.sh text eol=lf
*.mmd text eol=lf
*.prompt text eol=lf
*.mdc text eol=lf
*.rules text eol=lf

# Explicit binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.tar binary
*.gz binary
*.zip binary
